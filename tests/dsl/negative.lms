# ---- regressions from the second bug-hunting round (2026-10-20)
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let t = torch.tensor("[3, [1, 2]]");
end _dsl_
fails_at("scalar before a list is ragged (read uninitialized memory before the fix)", p, 219, 3, "run", "RUN_HOST", "ragged nested list");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let t = torch.tensor("[[1, 2], [3, [4]]]");
end _dsl_
fails_at("a list where a number belongs is ragged", p, 223, 3, "run", "RUN_HOST", "ragged nested list");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
torch.sequential().relu().save("relu-only.safetensors");
end _dsl_
fails_at("saving a parameterless model", p, 227, 3, "run", "RUN_HOST", "model has no parameters to save");
# A BOOL payload byte other than 0/1: header {"tensor":...} padded to 64 bytes, then bytes 0x02 0x07.
r = system(["sh", "-c", "printf '\\100\\000\\000\\000\\000\\000\\000\\000{\"tensor\":{\"dtype\":\"BOOL\",\"shape\":[2],\"data_offsets\":[0,2]}}    \\002\\007' > badbool.safetensors"]);
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let t = torch.load("badbool.safetensors");
end _dsl_
fails_at("BOOL bytes must be 0 or 1", p, 233, 3, "run", "RUN_HOST", "holds a byte other than 0 or 1");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
torch.sequential().linear(2, 2).save("two.safetensors");
let b = torch.open("two.safetensors").meta("layers", "linear(2, 2) -> warp(3)");
b.save("bad-layers.safetensors");
let m = torch.load_model("bad-layers.safetensors");
end _dsl_
fails_at("load_model with an unknown layer", p, 240, 3, "run", "RUN_HOST", "unknown layer 'warp'");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let b = torch.bundle().put("0.weight", torch.zeros(2, 2)).put("0.bias", torch.zeros(2)).put("extra", torch.zeros(1));
b.save("extra.safetensors");
let m = torch.sequential().linear(2, 2).load("extra.safetensors");
end _dsl_
fails_at("Model.load refuses unexpected tensors", p, 246, 3, "run", "RUN_HOST", "has tensor 'extra' that this model does not have");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let w = torch.ones(2).requires_grad(true);
let l = (w * w).sum();
l.backward();
l.backward();
end _dsl_
fails_at("backward twice through a freed graph (libtorch message)", p, 253, 3, "run", "RUN_HOST", "backward through the graph a second time");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let v = torch.ones(2, 3).t().set(0, 5.0);
end _dsl_
fails_at("set on a non-contiguous view", p, 257, 3, "run", "RUN_HOST", "needs a contiguous tensor");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let x = torch.ones(2).index_select(0, torch.tensor("[5]"));
end _dsl_
fails_at("index_select out of range (libtorch message)", p, 261, 3, "run", "RUN_HOST", "Tensor.index_select:");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
let k = torch.list().add(torch.ones(1)).at(1);
end _dsl_
fails_at("TensorList index", p, 265, 3, "run", "RUN_HOST", "list index 1 is out of range for 1 tensors");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
torch.set_num_threads(0);
end _dsl_
fails_at("thread count", p, 269, 3, "run", "RUN_HOST", "thread count must be between 1 and 256");
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
out.write_text("missing-dir/x.txt", "x");
end _dsl_
fails_at("write into a missing directory names the path", p, 273, 3, "run", "RUN_HOST", "cannot write missing-dir/x.txt");

# Autograd recording is per file: a file that turns it off must not break training in the next file.
off = _dsl_ schema="../../schema/lmtorch.dsl.json";
torch.grad_enabled(false);
torch.manual_seed(1);
out.set("first_draw", torch.rand(1).item());
end _dsl_
train_next = _dsl_ schema="../../schema/lmtorch.dsl.json";
let w = torch.ones(2).requires_grad(true);
let l = (w * 3.0).sum();
l.backward();
out.set("grad_ok", w.grad().sum().item() == 6.0).set("second_draw", torch.rand(1).item());
end _dsl_
savedsl(off, "off.dslb");
savedsl(train_next, "train-next.dslb");
seq = run_files(["off.dslb", "train-next.dslb"]);
push(COUNT, "grad mode per file");
if (seq.code != 0 || !seq.line.result.grad_ok || seq.line.result.first_draw == seq.line.result.second_draw) {
  push(FAILED, "grad mode per file");
  println(f"FAIL grad mode per file / RNG continues across files: {json_stringify(seq.line)}");
}

total = len(COUNT);
if (len(FAILED) > 0) {
  println(f"negative: {len(FAILED)} of {total} cases failed");
  exit(1);
}
println(f"negative: {total} cases passed");
