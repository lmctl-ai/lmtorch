# Refusals and failures of the DSL host: every case asserts the exit code, phase, error code and a message fragment.
# Usage (cwd = a scratch directory): lmscript /path/to/tests/dsl/negative.lms /path/to/lmtorch
BIN = ARGV.get(0, "lmtorch");
FAILED = [];
COUNT = [];

fn run_files(files) {
  r = system ${BIN} --dsl ${files};
  return {code: r.code, line: trim(r.stdout) == "" ? {} : json_parse(trim(r.stdout))};
}
fn expect(name, r, code, phase, err, fragment) {
  push(COUNT, name);
  line = r.line;
  ok = r.code == code && line.get("phase", "") == phase && line.get("code", "") == err && contains(line.get("message", ""), fragment);
  if (!ok) {
    push(FAILED, name);
    println(f"FAIL {name}: exit {r.code}, line {json_stringify(line)}; wanted exit {code} {phase} {err} containing '{fragment}'");
  }
}
# A run-time failure must also carry the DSL source line of the faulting call.
fn fails_at(name, prog, line_no, code, phase, err, fragment) {
  path = f"neg-{len(COUNT)}.dslb";
  savedsl(prog, path);
  r = run_files([path]);
  expect(name, r, code, phase, err, fragment);
  if (r.line.get("line", -1) != line_no) {
    push(FAILED, name);
    println(f"FAIL {name}: reported line {r.line.get('line', -1)}, wanted {line_no}");
  }
}

# ---- load-time refusals: nothing runs
write_file("bad-magic.dslb", "NOPE");
expect("bad magic", run_files(["bad-magic.dslb"]), 3, "load", "LOAD_BAD_BYTECODE", "bad magic");
expect("missing file", run_files(["no-such.dslb"]), 3, "load", "LOAD_BAD_BYTECODE", "no-such.dslb");
ok_prog = _dsl_ schema="../../schema/lmtorch.dsl.json";
out.set("ran", true);
end _dsl_
savedsl(ok_prog, "ok.dslb");
r = system(["sh", "-c", "head -c 60 ok.dslb > truncated.dslb"]);
expect("truncated", run_files(["truncated.dslb"]), 3, "load", "LOAD_BAD_BYTECODE", "truncated");
r = system(["sh", "-c", "cat ok.dslb > trailing.dslb && printf x >> trailing.dslb"]);
expect("trailing bytes", run_files(["trailing.dslb"]), 3, "load", "LOAD_BAD_BYTECODE", "trailing");
mismatch = _dsl_ schema="fixtures/other-schema-bytes.dsl.json";
out.set("ran", true);
end _dsl_
savedsl(mismatch, "mismatch.dslb");
expect("schema bytes differ", run_files(["mismatch.dslb"]), 3, "load", "LOAD_SCHEMA_MISMATCH", "schema mismatch");
writes = _dsl_ schema="../../schema/lmtorch.dsl.json";
out.write_text("side-effect.txt", "ran");
end _dsl_
savedsl(writes, "writes.dslb");
expect("a bad later file is refused before anything runs", run_files(["writes.dslb", "bad-magic.dslb"]), 3, "load", "LOAD_BAD_BYTECODE", "bad-magic.dslb");
if (file_exists("side-effect.txt")) { push(FAILED, "side effect"); println("FAIL: the first file ran although a later file was refused"); }
two = run_files(["ok.dslb", "writes.dslb"]);
expect("two good files run in order", {code: two.code == 0 ? 3 : 0, line: {phase: "x", code: "y", message: "z"}}, 3, "x", "y", "z");
if (!file_exists("side-effect.txt") || !two.line.result.ran) { push(FAILED, "two files"); println("FAIL: both files should have run"); }

# ---- usage errors: exit 2 and no result line
for (args in [["--dsl"], ["--dsl", "--x"], ["--dsl-schema", "--bad"], ["--dsl-signatures", "extra"], ["--dsl", ""]]) {
  push(COUNT, "usage");
  u = system ${BIN} ${args};
  if (u.code != 2 || trim(u.stdout) != "") { push(FAILED, "usage"); println(f"FAIL usage {json_stringify(args)}: exit {u.code}"); }
}

# ---- run-time failures: located host errors (exit 3), VM errors and application failures (exit 4)
p = _dsl_ schema="../../schema/lmtorch.dsl.json";
