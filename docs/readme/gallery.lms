mode = ARGV.get(0, "sum");
theme = ARGV.get(1, "dark");
dark = theme == "dark";
sum_prog = _dsl_ cli="lmtorch" install="github:lmctl-ai/lmtorch@latest";
let values = torch.tensor("[[1.0, 2.0], [3.0, 4.0]]");
let total = values.sum().item();
out.check(total == 10.0, "tensor sum must be 10");
out.set("total", total);
end _dsl_
grad_prog = _dsl_ cli="lmtorch" install="github:lmctl-ai/lmtorch@latest";
let x = torch.tensor("[1.0, -2.0, 3.0]").requires_grad(true);
let loss = x.square().sum(); loss.backward();
let grad = x.grad();
out.check(grad.allclose(x.detach() * 2.0, 0.0, 0.0), "gradient must equal 2x");
out.set("gradient", grad);
end _dsl_
savedsl(sum_prog, "build/readme/sum.dslb");
sum_run = system ${dsl_cli(sum_prog)} --dsl build/readme/sum.dslb;
if (sum_run.code != 0) { println(str(sum_run.stderr)); exit(sum_run.code); }
SUM_TEXT = str(json_parse(sum_run.stdout).result.total);
if (SUM_TEXT != "10") { println("unexpected sum result"); exit(1); }
savedsl(grad_prog, "build/readme/gradient.dslb");
grad_run = system ${dsl_cli(grad_prog)} --dsl build/readme/gradient.dslb;
if (grad_run.code != 0) { println(str(grad_run.stderr)); exit(grad_run.code); }
grad_result = json_parse(grad_run.stdout).result.gradient;
G0 = num(grad_result[0]); G1 = num(grad_result[1]); G2 = num(grad_result[2]);
if (G0 != 2 || G1 != -4 || G2 != 6) { println("unexpected gradient result"); exit(1); }
G0_TEXT = str(G0); G1_TEXT = str(G1); G2_TEXT = str(G2);
H0 = G0 * 12.0; H1 = G1 * -12.0; H2 = G2 * 12.0;
Y0 = 278.0 - H0; Y2 = 278.0 - H2;
DATA = read_json("build/readme/plot-gallery.json");
P0A = DATA.class0[0]; P0B = DATA.class0[1]; P0C = DATA.class0[2]; P0D = DATA.class0[3];
P1A = DATA.class1[0]; P1B = DATA.class1[1]; P1C = DATA.class1[2]; P1D = DATA.class1[3];
BOUNDARY = DATA.boundary; LOSS = DATA.loss;
PNG = "build/rendered/readme-gallery-" + mode + "-" + theme + ".png";
bg = dark ? "#101923" : "#f4f7fb";
panel = dark ? "#182635" : "#ffffff";
ink = dark ? "#f2f6fb" : "#172434";
muted = dark ? "#b4c2d0" : "#526274";
blue = dark ? "#79d4c3" : "#087f72";
orange = dark ? "#f5c16c" : "#ad6500";
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1000, 420, ${bg});
scene.rect(32.0, 30.0, 936.0, 360.0, ${panel});
if (${mode} == "sum") {
  scene.text(78.0, 116.0, 48.0, "Tensor reduction", ${ink}).set_attr("font-weight", "700");
  scene.text(80.0, 206.0, 52.0, "1 + 2 + 3 + 4", ${muted});
  scene.text(78.0, 327.0, 92.0, "sum = " + ${SUM_TEXT}, ${orange}).set_attr("font-weight", "700");
} else if (${mode} == "gradient") {
  scene.text(78.0, 116.0, 48.0, "Automatic differentiation", ${ink}).set_attr("font-weight", "700");
  scene.text(80.0, 176.0, 30.0, "d(sum(x^2)) / dx", ${muted});
  scene.line(230.0, 282.0, 840.0, 282.0, ${muted}, 2.0);
  scene.rect(328.0, float(${Y0}), 94.0, float(${H0}), ${blue});
  scene.rect(488.0, 278.0, 94.0, float(${H1}), ${orange});
  scene.rect(648.0, float(${Y2}), 94.0, float(${H2}), ${blue});
  scene.text(355.0, 350.0, 28.0, ${G0_TEXT}, ${muted});
  scene.text(505.0, 350.0, 28.0, ${G1_TEXT}, ${muted});
  scene.text(675.0, 350.0, 28.0, ${G2_TEXT}, ${muted});
} else if (${mode} == "training") {
  scene.text(78.0, 116.0, 48.0, "Training loss", ${ink}).set_attr("font-weight", "700");
  scene.path(${LOSS}, "none", ${blue}, 7.0);
  scene.text(78.0, 352.0, 30.0, ${DATA.loss_summary}, ${muted});
} else {
  scene.text(78.0, 116.0, 48.0, "Two-moons classifier", ${ink}).set_attr("font-weight", "700");
  scene.text(80.0, 174.0, 32.0, ${DATA.accuracy_text}, ${muted});
  scene.rect(112.0, 194.0, 856.0, 174.0, ${bg});
  let boundary = scene.path(${BOUNDARY}, "none", ${orange}, 4.0);
  boundary.set_attr("stroke-linecap", "round").set_attr("stroke-linejoin", "round");
  scene.path(${P0A}, ${blue}, "none", 1.0); scene.path(${P0B}, ${blue}, "none", 1.0);
  scene.path(${P0C}, ${blue}, "none", 1.0); scene.path(${P0D}, ${blue}, "none", 1.0);
  scene.path(${P1A}, ${orange}, "none", 1.0); scene.path(${P1B}, ${orange}, "none", 1.0);
  scene.path(${P1C}, ${orange}, "none", 1.0); scene.path(${P1D}, ${orange}, "none", 1.0);
}
scene.render_png(${PNG}, 1000, 420, 1);
end _dsl_
host = "build/readme-gallery-" + mode + "-" + theme + ".dslb";
savedsl(p, host);
r = system ${dsl_cli(p)} --dsl ${host};
if (r.code != 0) { println(str(r.stderr)); exit(r.code); }
