out = ARGV.len() > 0 ? ARGV[0] : "build/readme-hero.dslb";
theme = ARGV.get(1, "dark");
PNG_PATH = "build/rendered/readme-hero-" + theme + ".png";
dark = theme == "dark";
bg = dark ? "#101923" : "#f4f7fb";
panel = dark ? "#182635" : "#ffffff";
ink = dark ? "#f2f6fb" : "#172434";
muted = dark ? "#b4c2d0" : "#526274";
accent = dark ? "#79d4c3" : "#087f72";
warm = dark ? "#f5c16c" : "#ad6500";
GRID = read_json("build/readme/classifier-grid.json");
MAP0 = GRID.map[0]; MAP1 = GRID.map[1]; MAP2 = GRID.map[2]; MAP3 = GRID.map[3];
MAP4 = GRID.map[4]; MAP5 = GRID.map[5]; MAP6 = GRID.map[6]; MAP7 = GRID.map[7];
MAP8 = GRID.map[8]; MAP9 = GRID.map[9]; MAP10 = GRID.map[10]; MAP11 = GRID.map[11]; MAP12 = GRID.map[12];
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1400, 560, ${bg});
scene.text(72.0, 78.0, 18.0, "LMTORCH  /  CPU TENSORS + AUTOGRAD", ${accent}).set_attr("font-weight", "700");
scene.text(72.0, 190.0, 58.0, "A small model,", ${ink}).set_attr("font-weight", "700");
scene.text(72.0, 260.0, 58.0, "a learned boundary.", ${warm}).set_attr("font-weight", "700");
scene.text(76.0, 330.0, 21.0, "Two moons classified by a native CPU MLP.", ${muted});
scene.text(76.0, 371.0, 17.0, "Seed 7  ·  2–16–16–2  ·  400 generated points", ${muted});
scene.rect(76.0, 430.0, 180.0, 58.0, ${panel});
scene.text(94.0, 467.0, 22.0, ${GRID.accuracy} + "% test accuracy", ${accent}).set_attr("font-weight", "700");
scene.rect(674.0, 48.0, 660.0, 458.0, ${panel});
scene.text(714.0, 92.0, 17.0, "PREDICTED CLASS AT EACH GRID POINT", ${muted}).set_attr("font-weight", "700");
scene.text(716.0, 139.0, 17.0, "o upper moon     x lower moon", ${muted});
scene.text(718.0, 174.0, 18.0, ${MAP0}, ${accent});
scene.text(718.0, 197.0, 18.0, ${MAP1}, ${accent});
scene.text(718.0, 220.0, 18.0, ${MAP2}, ${accent});
scene.text(718.0, 243.0, 18.0, ${MAP3}, ${accent});
scene.text(718.0, 266.0, 18.0, ${MAP4}, ${accent});
scene.text(718.0, 289.0, 18.0, ${MAP5}, ${accent});
scene.text(718.0, 312.0, 18.0, ${MAP6}, ${accent});
scene.text(718.0, 335.0, 18.0, ${MAP7}, ${accent});
scene.text(718.0, 358.0, 18.0, ${MAP8}, ${accent});
scene.text(718.0, 381.0, 18.0, ${MAP9}, ${accent});
scene.text(718.0, 404.0, 18.0, ${MAP10}, ${accent});
scene.text(718.0, 427.0, 18.0, ${MAP11}, ${accent});
scene.text(718.0, 450.0, 18.0, ${MAP12}, ${accent});
scene.text(718.0, 485.0, 13.0, "The grid is printed by examples/classify-moons-dsl.lms", ${muted});
scene.render_png(${PNG_PATH}, 1400, 560, 1);
end _dsl_
savedsl(p, out);
run = system ${dsl_cli(p)} --dsl ${out};
if (run.code != 0) { println(str(run.stderr)); exit(run.code); }
