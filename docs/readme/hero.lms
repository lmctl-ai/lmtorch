theme = ARGV.get(0, "dark");
layout = ARGV.get(1, "desktop");
dark = theme == "dark";
mobile = layout == "mobile";
DATA = read_json(mobile ? "build/readme/plot-mobile.json" : "build/readme/plot-desktop.json");
P0A = DATA.class0[0]; P0B = DATA.class0[1]; P0C = DATA.class0[2]; P0D = DATA.class0[3];
P1A = DATA.class1[0]; P1B = DATA.class1[1]; P1C = DATA.class1[2]; P1D = DATA.class1[3];
B0 = DATA.boundary[0]; B1 = DATA.boundary[1]; B2 = DATA.boundary[2]; B3 = DATA.boundary[3];
B4 = DATA.boundary[4]; B5 = DATA.boundary[5]; B6 = DATA.boundary[6]; B7 = DATA.boundary[7];
PNG = "build/rendered/readme-hero-" + layout + "-" + theme + ".png";
bg = dark ? "#101923" : "#f4f7fb";
panel = dark ? "#182635" : "#ffffff";
ink = dark ? "#f2f6fb" : "#172434";
muted = dark ? "#b4c2d0" : "#526274";
blue = dark ? "#79d4c3" : "#087f72";
orange = dark ? "#f5c16c" : "#ad6500";
edge = dark ? "#dce4ed" : "#26384c";
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
if (${mobile}) {
  scene.canvas(780, 990, ${bg});
  scene.text(54.0, 115.0, 68.0, "Two moons.", ${ink}).set_attr("font-weight", "700");
  scene.text(54.0, 196.0, 68.0, "One learned curve.", ${orange}).set_attr("font-weight", "700");
  scene.rect(42.0, 294.0, 696.0, 628.0, ${panel});
  scene.rect(78.0, 335.0, 624.0, 540.0, ${bg});
  let boundary = scene.path(${B0}, "none", ${edge}, 5.0);
  boundary.set_attr("stroke-linecap", "round");
  scene.path(${B1}, "none", ${edge}, 5.0); scene.path(${B2}, "none", ${edge}, 5.0);
  scene.path(${B3}, "none", ${edge}, 5.0); scene.path(${B4}, "none", ${edge}, 5.0);
  scene.path(${B5}, "none", ${edge}, 5.0); scene.path(${B6}, "none", ${edge}, 5.0);
  scene.path(${B7}, "none", ${edge}, 5.0);
  scene.path(${P0A}, ${blue}, "none", 1.0); scene.path(${P0B}, ${blue}, "none", 1.0);
  scene.path(${P0C}, ${blue}, "none", 1.0); scene.path(${P0D}, ${blue}, "none", 1.0);
  scene.path(${P1A}, ${orange}, "none", 1.0); scene.path(${P1B}, ${orange}, "none", 1.0);
  scene.path(${P1C}, ${orange}, "none", 1.0); scene.path(${P1D}, ${orange}, "none", 1.0);
  scene.text(80.0, 908.0, 28.0, "97.5% held-out accuracy", ${blue}).set_attr("font-weight", "700");
  scene.render_png(${PNG}, 780, 990, 1);
} else {
  scene.canvas(1400, 620, ${bg});
  scene.text(72.0, 118.0, 19.0, "LMTORCH  /  CPU TENSORS + AUTOGRAD", ${blue}).set_attr("font-weight", "700");
  scene.text(72.0, 240.0, 68.0, "Two moons.", ${ink}).set_attr("font-weight", "700");
  scene.text(72.0, 325.0, 68.0, "One learned curve.", ${orange}).set_attr("font-weight", "700");
  scene.text(78.0, 390.0, 34.0, "lmtorch  /  native CPU neural nets", ${muted});
  scene.text(78.0, 470.0, 38.0, "97.5% held-out accuracy", ${blue}).set_attr("font-weight", "700");
  scene.rect(725.0, 46.0, 630.0, 528.0, ${panel});
  scene.rect(758.0, 78.0, 564.0, 464.0, ${bg});
  let boundary = scene.path(${B0}, "none", ${edge}, 4.0);
  boundary.set_attr("stroke-linecap", "round");
  scene.path(${B1}, "none", ${edge}, 4.0); scene.path(${B2}, "none", ${edge}, 4.0);
  scene.path(${B3}, "none", ${edge}, 4.0); scene.path(${B4}, "none", ${edge}, 4.0);
  scene.path(${B5}, "none", ${edge}, 4.0); scene.path(${B6}, "none", ${edge}, 4.0);
  scene.path(${B7}, "none", ${edge}, 4.0);
  scene.path(${P0A}, ${blue}, "none", 1.0); scene.path(${P0B}, ${blue}, "none", 1.0);
  scene.path(${P0C}, ${blue}, "none", 1.0); scene.path(${P0D}, ${blue}, "none", 1.0);
  scene.path(${P1A}, ${orange}, "none", 1.0); scene.path(${P1B}, ${orange}, "none", 1.0);
  scene.path(${P1C}, ${orange}, "none", 1.0); scene.path(${P1D}, ${orange}, "none", 1.0);
  scene.render_png(${PNG}, 1400, 620, 1);
}
end _dsl_
host = "build/readme-hero-" + layout + "-" + theme + ".dslb";
savedsl(p, host);
r = system ${dsl_cli(p)} --dsl ${host};
if (r.code != 0) { println(str(r.stderr)); exit(r.code); }
