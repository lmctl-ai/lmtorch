theme = ARGV.get(0, "dark");
dark = theme == "dark";
PNG = "build/rendered/readme-architecture-" + theme + ".png";
bg = dark ? "#111c28" : "#f4f7fb";
panel = dark ? "#203447" : "#ffffff";
ink = dark ? "#f2f6f7" : "#172434";
accent = dark ? "#f5c16c" : "#ad6500";
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(760, 900, ${bg});
scene.rect(56.0, 52.0, 648.0, 148.0, ${panel});
scene.rect(56.0, 250.0, 648.0, 148.0, ${panel});
scene.rect(56.0, 448.0, 648.0, 148.0, ${panel});
scene.rect(56.0, 646.0, 648.0, 148.0, ${panel});
scene.text(380.0, 145.0, 52.0, "LMScript", ${ink}).set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(380.0, 343.0, 52.0, "DSL schema", ${ink}).set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(380.0, 541.0, 52.0, "lmtorch", ${ink}).set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(380.0, 739.0, 48.0, "Tensor results", ${ink}).set_attr("text-anchor", "middle").set_attr("font-weight", "700");
let a = scene.line(380.0, 208.0, 380.0, 238.0, ${accent}, 4.0); a.set_attr("marker-end", "arrow");
let b = scene.line(380.0, 406.0, 380.0, 436.0, ${accent}, 4.0); b.set_attr("marker-end", "arrow");
let c = scene.line(380.0, 604.0, 380.0, 634.0, ${accent}, 4.0); c.set_attr("marker-end", "arrow");
scene.render_png(${PNG}, 760, 900, 1);
end _dsl_
host = "build/readme-architecture-" + theme + ".dslb";
savedsl(p, host);
r = system ${dsl_cli(p)} --dsl ${host};
if (r.code != 0) { println(str(r.stderr)); exit(r.code); }
