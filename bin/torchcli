#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
repos_dir=$(dirname -- "$(dirname -- "$project_dir")")
case "$PWD/" in
  "$repos_dir/"*) ;;
  *) echo "torchcli: current directory must be under $repos_dir" >&2; exit 2 ;;
esac
uid=$(id -u)
gid=$(id -g)
out=$(mktemp)
err=$(mktemp)
set +e
docker run --rm --network=none --cpus=2 --memory=5g -u "$uid:$gid" -v "$repos_dir:$repos_dir" -w "$PWD" torchcli:dev "$@" >"$out" 2>"$err"
rc=$?
set -e
if [ -s "$out" ]; then cat "$out"; fi
if [ -s "$err" ]; then cat "$err" >&2; fi
if [ ! -s "$out" ] && [ "$rc" -ne 0 ]; then
  printf '{"success":false,"error":{"code":"SERVICE_UNAVAILABLE","message":"torchcli container failed to start","data":{"docker_exit":%s}}}\n' "$rc"
  rc=8
fi
rm -f "$out" "$err"
exit "$rc"
