# The ones -> matmul -> add -> softmax chain as one lmcode program in one lmtorch process.
# Run: lmscript examples/tensor-chain.lms [run_dir]      (lmtorch on PATH, else installed from the release)
import "./lib/torchdsl.lms";

RUN = ARGV.get(0, "artifacts/tensor-chain");
mkdir(RUN, true);

chain = _lmcode_ cli="lmtorch" install="github:lmctl-ai/lmtorch@latest";
let run = ${RUN};
let a = torch.ones(2, 2);
let b = a.matmul(a);
# Tensor operators map to schema methods: + is add, * is mul, - is sub.
let c = b + a;
let d = c.softmax(1);
d.save(run + "/d.safetensors");
out.set("shape", d.shape()).set("values", d.flatten());
out.check(d.allclose(torch.full(2, 2, 0.5), 0.0, 0.000001), "softmax of equal rows must be 0.5 everywhere");
end _lmcode_

res = torchdsl.run_block(chain);
if (res != null) {
  println(res.values);
}
