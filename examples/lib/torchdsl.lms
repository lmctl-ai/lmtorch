package torchdsl;
# Shared lmcode invocation handling for the examples. lmscript attaches the native host to each program, and run_lmcode
# supplies manifest v1, launches the host and decodes its terminal return frame.
fn run(program_or_builder) {
  res = run_lmcode(program_or_builder);
  if (res.get("dry", false)) { return null; }
  if (!res.ok) {
    where = res.has("line") ? f" (lmcode line {res.line})" : "";
    println(f"lmtorch {res.phase} error {res.code}{where}: {res.message}");
    exit(1);
  }
  return res.result;
}

fn run_block(program) {
  return run(program);
}
