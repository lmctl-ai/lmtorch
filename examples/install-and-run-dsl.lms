# The zero-setup way to use lmtorch from lmscript: no schema file and no manual install.
#   - cli="lmtorch" makes lmscript ask the lmtorch binary for its schema (`lmtorch --dsl-schema --json`) and compile against
#     exactly those bytes, so the bytecode is bound to the binary that will run it;
#   - install="github:lmctl-ai/lmtorch@v0.3.0" says where lmtorch comes from when it is not on PATH: lmscript downloads the
#     release asset lmtorch-OS-ARCH[.exe] once into its tool cache, verified against the SHA-256 digest GitHub reports, and
#     uses it from then on;
#   - dsl_cli(p) is the argv prefix of that exact binary, so `system ${dsl_cli(p)} --dsl FILE` runs it.
# The program itself: a matrix product, an autograd gradient and a two-parameter least-squares fit, with known answers.
# Run: lmscript examples/install-and-run-dsl.lms   (works on a machine with only Node.js and lmscript installed)

p = _dsl_ cli="lmtorch" install="github:lmctl-ai/lmtorch@v0.3.0";
let a = torch.tensor("[[1.0, 2.0], [3.0, 4.0]]");
out.set("matmul_sum", a.matmul(a).sum().item());
let x = torch.tensor("[1.0, 2.0, 3.0]").requires_grad(true);
let y = (x * x).sum();
y.backward();
out.set("grad", x.grad());
let xs = torch.linspace(0.0, 1.0, 11).reshape(11, 1);
let ys = xs * 2.0 + 1.0;
let model = torch.sequential().linear(1, 1);
let opt = torch.adam(model, 0.1);
let i = 0;
while (i < 500) {
  opt.zero_grad();
  let loss = (model.forward(xs) - ys).square().mean();
  loss.backward();
  opt.step();
  i = i + 1;
}
out.set("fit_mse", (model.forward(xs) - ys).square().mean().item());
end _dsl_

file = "install-and-run.dslb";
savedsl(p, file);
r = system ${dsl_cli(p)} --dsl ${file};
delete_file(file);
if (r.code != 0) {
  println(f"lmtorch exit {r.code}: {trim(r.stdout)} {trim(r.stderr)}");
  exit(1);
}
res = json_parse(r.stdout).result;
ok = res.matmul_sum == 54.0 && json_stringify(res.grad) == "[2,4,6]" && res.fit_mse < 0.000001;
println(f"lmtorch at {dsl_cli(p)[0]}");
mse = sprintf("%.9f", res.fit_mse);
println(f"matmul sum {res.matmul_sum}, grad {json_stringify(res.grad)}, fit mse {mse}");
if (!ok) {
  println("Install-and-run FAILED.");
  exit(1);
}
println("Install-and-run passed.");
