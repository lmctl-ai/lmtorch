# Train one two-layer ReLU MLP with the lmcode host, save the portable Model checkpoint,
# and verify that the checkpoint reload produces bit-identical predictions.
import "./lib/torchdsl.lms";

RUN = ARGV.get(0, "artifacts/mlp-train");
mkdir(RUN, true);

train = _lmcode_ cli="lmtorch" install="github:lmctl-ai/lmtorch@latest";
let run = ${RUN};
torch.manual_seed(11);
let model = torch.sequential().linear(2, 4).relu().linear(4, 1);
let opt = torch.sgd(model, 0.05);
let x = torch.tensor("[[0, 0], [0, 1], [1, 0], [1, 1]]", DType.F32);
let y = torch.tensor("[[0], [1], [1], [2]]", DType.F32);
let first = 0.0;
let last = 0.0;
for (step in range(1, 21)) {
  opt.zero_grad();
  let loss = model.forward(x).mse_loss(y);
  loss.backward();
  opt.step();
  if (step == 1) { first = loss.item(); }
  last = loss.item();
  out.append("loss", last);
}
out.check(last < first, "training loss did not decrease");
model.save(run + "/checkpoint_20.safetensors");
let restored = torch.load_model(run + "/checkpoint_20.safetensors");
let prediction = model.forward(x);
out.check(restored.forward(x).allclose(prediction, 0.0, 0.0), "saved model round-trip changed predictions");
out.set("first", first).set("last", last).set("prediction", prediction.flatten());
end _lmcode_

res = torchdsl.run_block(train);
if (res != null) {
  println(sprintf("loss first: %.6f last: %.6f", res.first, res.last), "prediction:", res.prediction);
}
