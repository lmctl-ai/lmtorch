# Multi-step task: choose a learning rate by sweeping, then train the winner longer and verify it on held-out points.
#   1 sweep     the same DSL program is compiled once per candidate rate (${} makes the rate a literal) and every compiled
#               program runs in ONE lmtorch process; each reports its final loss under its own key
#   2 select    lmscript discards diverged runs (non-finite loss comes back as null) and picks the lowest final loss
#   3 refine    train the winning rate for 5x the steps and save the model
#   4 verify    reload the model, score a held-out grid, fail the run (exit 4) unless the error is small
# Task: fit y = sin(3x) on [-1, 1] with a 1-32-1 tanh network and SGD with momentum.
# Run: lmscript examples/lr-sweep-dsl.lms [run_dir]
import "./lib/torchdsl.lms";

RUN = ARGV.get(0, "artifacts/lr-sweep-dsl");
STEPS = 150;
mkdir(RUN, true);
RATES = [0.0005, 0.005, 0.02, 0.05, 0.2, 3.0];

files = [];
for (i = 0; i < len(RATES); i = i + 1) {
  LR_MICRO = round(RATES[i] * 1000000);
  KEY = f"lr{i}";
  sweep = _dsl_ schema="../schema/lmtorch.dsl.json";
torch.manual_seed(1);
let x = torch.linspace(-1.0, 1.0, 64).reshape(64, 1);
let y = (x * 3.0).sin();
let model = torch.sequential().linear(1, 32).tanh().linear(32, 1);
let opt = torch.sgd(model, float(${LR_MICRO}) / 1000000.0, 0.9);
let loss = 0.0;
for (step in range(0, ${STEPS})) {
  let mark = torch.mark();
  opt.zero_grad();
  let l = model.forward(x).mse_loss(y);
  l.backward();
  opt.step();
  loss = l.item();
  torch.release(mark);
}
out.set(${KEY}, loss);
end _dsl_
  path = path_join(RUN, f"sweep-{i}.dslb");
  savedsl(sweep, path);
  push(files, path);
}
res = torchdsl.run(files);
if (res == null) { exit(0); }

BEST = -1;
println("1 sweep (final MSE after " + str(STEPS) + " steps):");
for (i = 0; i < len(RATES); i = i + 1) {
  loss = res[f"lr{i}"];
  println(sprintf("   lr %-8s %s", str(RATES[i]), loss == null ? "diverged" : sprintf("%.6f", loss)));
  if (loss != null && (BEST < 0 || loss < res[f"lr{BEST}"])) { BEST = i; }
}
if (BEST < 0) { println("every rate diverged"); exit(1); }
LR = RATES[BEST];
println(f"2 select: lr {LR}");

LR_MICRO = round(LR * 1000000);
LONG = STEPS * 5;
refine = _dsl_ schema="../schema/lmtorch.dsl.json";
let run = ${RUN};
torch.manual_seed(1);
let x = torch.linspace(-1.0, 1.0, 64).reshape(64, 1);
let y = (x * 3.0).sin();
let model = torch.sequential().linear(1, 32).tanh().linear(32, 1);
let opt = torch.sgd(model, float(${LR_MICRO}) / 1000000.0, 0.9);
for (step in range(0, ${LONG})) {
  let mark = torch.mark();
  opt.zero_grad();
  let l = model.forward(x).mse_loss(y);
  l.backward();
  opt.step();
  if ((step + 1) % 150 == 0) { out.append("loss", l.item()); }
  torch.release(mark);
}
model.save(run + "/best.safetensors");
end _dsl_

verify = _dsl_ schema="../schema/lmtorch.dsl.json";
let run = ${RUN};
torch.grad_enabled(false);
let model = torch.load_model(run + "/best.safetensors");
# Held-out points sit between the training points.
let x = torch.linspace(-0.99, 0.99, 50).reshape(50, 1);
let err = (model.forward(x) - (x * 3.0).sin()).abs();
out.set("heldout_max_error", err.max().item()).set("heldout_mse", err.square().mean().item());
out.check(err.max().item() < 0.1, "held-out error is too large");
end _dsl_
savedsl(refine, path_join(RUN, "refine.dslb"));
savedsl(verify, path_join(RUN, "verify.dslb"));
final = torchdsl.run([path_join(RUN, "refine.dslb"), path_join(RUN, "verify.dslb")]);
trail = [];
for (v in final.loss) { push(trail, sprintf("%.5f", v)); }
println(f"3 refine: {LONG} steps, loss every 150 steps: {join(trail, ' ')}");
println(sprintf("4 verify: held-out MSE %.6f, max error %.4f", final.heldout_mse, final.heldout_max_error));
