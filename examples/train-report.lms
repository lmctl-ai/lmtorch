// Cross-tool regression demo: torchcli trains the model; lmcreator renders the figures and report.
import "../cli.schema.dev.json" as torchcli;
import "../../../lmctlhq/lmcreator/cli.schema.dev.json" as creator;

RUN = len(ARGV) > 0 ? ARGV[0] : "artifacts/train-report";
STEPS = len(ARGV) > 1 ? num(ARGV[1]) : 60;
LR = len(ARGV) > 2 ? num(ARGV[2]) : 0.05;
SEED = len(ARGV) > 3 ? num(ARGV[3]) : 11;
if (STEPS < 1 || floor(STEPS) != STEPS || LR <= 0 || floor(SEED) != SEED || SEED < 0) {
  println("steps and seed must be nonnegative integers (steps > 0), and lr must be positive");
  exit(1);
}

mkdir(RUN, true);
CHARTS = path_join(RUN, "charts");
DIAGRAM = path_join(RUN, "diagram");
mkdir(CHARTS, true);
mkdir(DIAGRAM, true);

// A deterministic 4x4 grid with a learnable bilinear target.
GRID = [-1.5, -0.5, 0.5, 1.5];
X_VALUES = [];
Y_VALUES = [];
for (i = 0; i < len(GRID); i = i + 1) {
  for (j = 0; j < len(GRID); j = j + 1) {
    x1 = GRID[i];
    x2 = GRID[j];
    push(X_VALUES, x1);
    push(X_VALUES, x2);
    push(Y_VALUES, x1 + 2 * x2 - 0.5 * x1 * x2);
  }
}

X = torchcli.tensor_create({shape: [16, 2], values: X_VALUES, out: path_join(RUN, "train-x.safetensors")});
if (X.status == "error") { println(X.error.message); exit(1); }
if (X.status == "simulated") { println("train-report dry-run: create data, train", STEPS, "steps, render charts and DOCX"); exit(0); }
Y = torchcli.tensor_create({shape: [16, 1], values: Y_VALUES, out: path_join(RUN, "train-y.safetensors")});
if (Y.status == "error") { println(Y.error.message); exit(1); }

W1 = torchcli.tensor_rand({shape: [8, 2], seed: SEED, out: path_join(RUN, "init-w1.safetensors")});
if (W1.status == "error") { println(W1.error.message); exit(1); }
B1 = torchcli.tensor_rand({shape: [8], seed: SEED + 1, out: path_join(RUN, "init-b1.safetensors")});
if (B1.status == "error") { println(B1.error.message); exit(1); }
W2 = torchcli.tensor_rand({shape: [1, 8], seed: SEED + 2, out: path_join(RUN, "init-w2.safetensors")});
if (W2.status == "error") { println(W2.error.message); exit(1); }
B2 = torchcli.tensor_rand({shape: [1], seed: SEED + 3, out: path_join(RUN, "init-b2.safetensors")});
if (B2.status == "error") { println(B2.error.message); exit(1); }
INITIAL = torchcli.tensor_save({
  tensors: {w1: W1.result.ref, b1: B1.result.ref, w2: W2.result.ref, b2: B2.result.ref},
  metadata: {torchcli_format: "1", arch: "mlp_relu_v1", step: "0"},
  out: path_join(RUN, "checkpoint-000.safetensors")
});
if (INITIAL.status == "error") { println(INITIAL.error.message); exit(1); }

CHECKPOINT = INITIAL.result.path;
LOSSES = [];
STEPS_X = [];
for (step = 1; step <= STEPS; step = step + 1) {
  NEXT = torchcli.mlp_train_step({
    checkpoint: CHECKPOINT,
    input: X.result.ref,
    target: Y.result.ref,
    lr: LR,
    out: path_join(RUN, sprintf("checkpoint-%03d.safetensors", step))
  });
  if (NEXT.status == "error") { println(NEXT.error.message); exit(1); }
  if (NEXT.status == "simulated") { println("train-report dry-run: training calls simulated"); exit(0); }
  CHECKPOINT = NEXT.result.path;
  push(LOSSES, NEXT.result.loss);
  push(STEPS_X, step);
}

TRAIN_FORWARD = torchcli.mlp_forward({checkpoint: CHECKPOINT, input: X.result.ref, out: path_join(RUN, "train-prediction.safetensors")});
if (TRAIN_FORWARD.status == "error") { println(TRAIN_FORWARD.error.message); exit(1); }
TEST_X_VALUES = [-1.25, 1.25, -0.25, 0.75, -0.25, -0.75, 1.25, 0.25];
TEST_Y_VALUES = [];
for (i = 0; i < len(TEST_X_VALUES); i = i + 2) {
  x1 = TEST_X_VALUES[i];
  x2 = TEST_X_VALUES[i + 1];
  push(TEST_Y_VALUES, x1 + 2 * x2 - 0.5 * x1 * x2);
}
TEST_X = torchcli.tensor_create({shape: [4, 2], values: TEST_X_VALUES, out: path_join(RUN, "heldout-x.safetensors")});
if (TEST_X.status == "error") { println(TEST_X.error.message); exit(1); }
TEST_FORWARD = torchcli.mlp_forward({checkpoint: CHECKPOINT, input: TEST_X.result.ref, out: path_join(RUN, "heldout-prediction.safetensors")});
if (TEST_FORWARD.status == "error") { println(TEST_FORWARD.error.message); exit(1); }
TRAIN_INSPECT = torchcli.tensor_inspect({input: TRAIN_FORWARD.result.ref, limit: 16});
if (TRAIN_INSPECT.status == "error") { println(TRAIN_INSPECT.error.message); exit(1); }
HELDOUT_INSPECT = torchcli.tensor_inspect({input: TEST_FORWARD.result.ref, limit: 4});
if (HELDOUT_INSPECT.status == "error") { println(HELDOUT_INSPECT.error.message); exit(1); }

FIRST_LOSS = LOSSES[0];
LAST_LOSS = LOSSES[len(LOSSES) - 1];
MIN_LOSS = FIRST_LOSS;
for (i = 0; i < len(LOSSES); i = i + 1) {
  if (LOSSES[i] < MIN_LOSS) { MIN_LOSS = LOSSES[i]; }
}
MEAN_Y = 0;
for (i = 0; i < len(Y_VALUES); i = i + 1) { MEAN_Y = MEAN_Y + Y_VALUES[i]; }
MEAN_Y = MEAN_Y / len(Y_VALUES);
SSE = 0;
SST = 0;
MAX_ABS_ERROR = 0;
for (i = 0; i < len(Y_VALUES); i = i + 1) {
  DELTA = TRAIN_INSPECT.result.values[i] - Y_VALUES[i];
  ABS_DELTA = DELTA < 0 ? -DELTA : DELTA;
  if (ABS_DELTA > MAX_ABS_ERROR) { MAX_ABS_ERROR = ABS_DELTA; }
  SSE = SSE + DELTA * DELTA;
  CENTERED = Y_VALUES[i] - MEAN_Y;
  SST = SST + CENTERED * CENTERED;
}
FINAL_MSE = SSE / len(Y_VALUES);
R2 = 1 - SSE / SST;

LOSS_CHART = creator.render_chart({
  spec: {
    title: "Training loss by step",
    xlabel: "SGD step",
    ylabel: "MSE loss",
    xlim: [1, STEPS],
    ylim: [0, FIRST_LOSS * 1.1],
    series: [{kind: "plot", x: STEPS_X, y: LOSSES, label: "training MSE", color: "#1f77b4"}],
    legend: true
  },
  out: CHARTS,
  name: "loss-vs-step"
});
if (LOSS_CHART.status == "error") { println(LOSS_CHART.error.message); exit(1); }

PRED_CHART = creator.render_chart({
  spec: {
    title: "Training predictions vs target",
    xlabel: "Target value",
    ylabel: "Predicted value",
    xlim: [-6, 5],
    ylim: [-6, 5],
    series: [
      {kind: "scatter", x: Y_VALUES, y: TRAIN_INSPECT.result.values, label: "predictions", color: "#1f77b4", marker: "o"},
      {kind: "plot", x: [-6, 5], y: [-6, 5], label: "ideal y = x", color: "#7f7f7f", linestyle: "--"}
    ],
    legend: true
  },
  out: CHARTS,
  name: "predicted-vs-target"
});
if (PRED_CHART.status == "error") { println(PRED_CHART.error.message); exit(1); }

FLOW = sprintf("flowchart LR\n  dataset[\"16-point dataset\"]\n  init[\"Initialize 2-8-1 MLP\"]\n  train[\"%d x train_step\"]\n  forward[\"Train + held-out forward\"]\n  report[\"Metrics, charts and DOCX\"]\n  dataset --> init\n  init --> train\n  train --> forward\n  forward --> report\n", STEPS);
LINT = creator.lint_spec({source: FLOW, kind: "mmd"});
if (LINT.status == "error") { println(LINT.error.message); exit(1); }
if (LINT.status == "ok" && LINT.result.errors > 0) { println("pipeline diagram lint found errors"); exit(1); }
DIAGRAM_RENDER = creator.render_diagram({source: FLOW, source_format: "mmd", out: DIAGRAM, name: "training-pipeline"});
if (DIAGRAM_RENDER.status == "error") { println(DIAGRAM_RENDER.error.message); exit(1); }

LOSS_PNG = "charts/loss-vs-step.png";
PRED_PNG = "charts/predicted-vs-target.png";
FLOW_PNG = "diagram/training-pipeline.png";
REPORT_MD = sprintf(
  "# Mini-model training report\n\nRun: `%s`  \nSteps: %d  \nLearning rate: %.4f  \nSeed: %d\n\n## Metrics\n\n- First step loss: %.6f\n- Last step loss: %.6f\n- Minimum step loss: %.6f\n- Final training MSE: %.6f\n- Maximum absolute training error: %.6f\n- Training R-squared: %.6f\n- Held-out predictions: `%s`\n- Held-out targets: `%s`\n\n## Loss by step\n\n![Training loss by step](%s)\n\n## Predicted vs target\n\n![Predicted vs target](%s)\n\n## Workflow\n\n![Training workflow](%s)\n",
  RUN, STEPS, LR, SEED, FIRST_LOSS, LAST_LOSS, MIN_LOSS, FINAL_MSE, MAX_ABS_ERROR, R2,
  str(HELDOUT_INSPECT.result.values), str(TEST_Y_VALUES), LOSS_PNG, PRED_PNG, FLOW_PNG
);
REPORT_FILE = path_join(RUN, "train-report.md");
write_file(REPORT_FILE, REPORT_MD);
REPORT = creator.export_document({file: REPORT_FILE, out: path_join(RUN, "train-report.docx"), lint: "error"});
if (REPORT.status == "error") { println(REPORT.error.message); exit(1); }

println(sprintf("steps: %d  lr: %.4f  seed: %d", STEPS, LR, SEED));
println(sprintf("loss first: %.6f  last: %.6f  min: %.6f", FIRST_LOSS, LAST_LOSS, MIN_LOSS));
println(sprintf("train MSE: %.6f  max abs error: %.6f  R2: %.6f", FINAL_MSE, MAX_ABS_ERROR, R2));
println("held-out predictions:", HELDOUT_INSPECT.result.values);
for (artifact in LOSS_CHART.result.artifacts) { println("loss chart:", artifact.path, artifact.bytes, "bytes"); }
for (artifact in PRED_CHART.result.artifacts) { println("prediction chart:", artifact.path, artifact.bytes, "bytes"); }
for (artifact in DIAGRAM_RENDER.result.artifacts) { println("pipeline diagram:", artifact.path, artifact.bytes, "bytes"); }
println("report:", REPORT.result.path, REPORT.result.bytes, "bytes");
println("report markdown:", REPORT_FILE);
